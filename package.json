{
  "name": "plates-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply plates-quest --local",
    "db:migrate:remote": "wrangler d1 migrations apply plates-quest --remote",
    "cf-typegen": "wrangler types",
    "deploy": "npm run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  }
}
